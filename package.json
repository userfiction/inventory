{
    "name": "@userfiction/inventory",
    "version": "1.0.2",
    "description": "Inventory system for User Fiction",
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "index.ts",
        "src",
        "**/*.ts",
        "!**/*.test.ts",
        "!vite.config.ts",
        "!demo",
        "!vitest.config.ts",
        "!**/*.d.ts",
        "!Temp/**",
        "!coverage/**"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "dev": "vite --config demo/vite.config.ts",
        "demo:build": "vite build --config demo/vite.config.ts",
        "demo:preview": "vite preview --config demo/vite.config.ts",
        "release": "vite-node ../../../scripts/publish-safe.ts"
    },
    "dependencies": {
        "@presource/core": "*"
    },
    "author": "NQQT",
    "license": "ISC",
    "devDependencies": {
        "@types/node": "^25.9.1",
        "typescript": "^6.0.0",
        "vite": "^8.0.8",
        "vitest": "^4.1.4"
    }
}
