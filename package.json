{
    "name": "@userfiction/inventory",
    "version": "1.0.2",
    "description": "Inventory system for User Fiction",
    "type": "module",
    "main": "./dist/userfiction-inventory.mjs",
    "module": "./dist/userfiction-inventory.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./index.ts",
            "import": "./dist/userfiction-inventory.mjs"
        }
    },
    "files": [
        "dist",
        "index.ts",
        "**/*.ts",
        "!**/*.test.ts",
        "!vite.config.ts"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "prepack": "npm run build",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "release": "vite-node ../../../scripts/publish-safe.ts"
    },
    "author": "NQQT",
    "license": "ISC",
    "devDependencies": {
        "@types/node": "^25.9.1",
        "typescript": "^6.0.0",
        "vite": "^8.0.8",
        "vitest": "^4.1.4"
    }
}
